<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TidyChests.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    The stash rules, the planner, the screen marker math, the chest search and the knowledge
    plan have no game or Unity dependency, so their sources are compiled straight into this
    project. That keeps the tests runnable on any machine without the game assemblies or a
    .NET Framework runtime.
  -->
  <ItemGroup>
    <Compile Include="../TidyChests/Stash/ItemFacts.cs" Link="Stash/ItemFacts.cs" />
    <Compile Include="../TidyChests/Stash/StashRuleSettings.cs" Link="Stash/StashRuleSettings.cs" />
    <Compile Include="../TidyChests/Stash/StashVerdict.cs" Link="Stash/StashVerdict.cs" />
    <Compile Include="../TidyChests/Stash/StashRules.cs" Link="Stash/StashRules.cs" />
    <Compile Include="../TidyChests/Stash/StashLocks.cs" Link="Stash/StashLocks.cs" />
    <Compile Include="../TidyChests/Stash/StashModels.cs" Link="Stash/StashModels.cs" />
    <Compile Include="../TidyChests/Stash/StashPlanner.cs" Link="Stash/StashPlanner.cs" />
    <Compile Include="../TidyChests/Hud/ScreenMarkerMath.cs" Link="Hud/ScreenMarkerMath.cs" />
    <Compile Include="../TidyChests/Index/IndexModels.cs" Link="Index/IndexModels.cs" />
    <Compile Include="../TidyChests/Index/ItemSearch.cs" Link="Index/ItemSearch.cs" />
    <Compile Include="../TidyChests/Index/BrowserSort.cs" Link="Index/BrowserSort.cs" />
    <Compile Include="../TidyChests/Index/FavoriteList.cs" Link="Index/FavoriteList.cs" />
    <Compile Include="../TidyChests/Knowledge/KnowledgePlan.cs" Link="Knowledge/KnowledgePlan.cs" />
    <Compile Include="../Shared/Windows/CursorRelease.cs" Link="Windows/CursorRelease.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>

</Project>
